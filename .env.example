# Copy this file to .env and fill in your own values.
# .env itself is gitignored -- never commit a real API key.

# Google Gemini API key. Leave empty to run in template/fallback mode
# (the offline eval harness still runs and produces real metrics, but
# generation and judging fall back to deterministic rules instead of a
# real LLM call).
GEMINI_API_KEY=

# gemini-3.6-flash is the current default -- see src/config.py's comment
# for why 2.x-generation models are no longer available to new API keys.
GEMINI_MODEL_NAME=gemini-3.6-flash

# "gemini" (default) or "mock" to force template-only mode regardless of
# whether GEMINI_API_KEY is set.
LLM_PROVIDER=gemini

# Live-verify any link a drafted reply cites by actually fetching it, so a
# fabricated or dead URL is caught before it ships (see
# src/drafting/link_checker.py). Deliberately off by default so the bulk
# eval harness (python -m src.eval.runner) stays offline and fast --
# recommended "true" for live dashboard/CLI/API use.
ENABLE_LIVE_LINK_CHECK=false

# Optional threshold overrides -- see src/config.py for the calibration
# behind the current defaults before changing these.
# MIN_INTENT_CONFIDENCE=0.40
# MIN_RETRIEVAL_SIMILARITY=0.20
# FRUSTRATION_THRESHOLD=0.60
